                "arguments": {
                    "num_inference_steps": 50,
                    "num_images_per_prompt": 1,
                    "height": 768,
                    "width": 768,
                    "intermediate_result_names": {
                        "hint": "hint",
                        "image_embeds": "image_embeds",
                        "negative_image_embeds": "negative_image_embeds"
                    }
