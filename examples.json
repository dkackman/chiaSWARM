                    "num_inference_steps": 25,
                    "num_images_per_prompt": 1,
                    "strength": 0.75
                }
            }
        ]
    },
    "kandinsky_controlnet": {
        "content_type": "image/png",
        "pipelines": [
            {
                "name": "depth_estimator",
                "configuration": {
                    "preprocessor": "depth_estimator",
                    "intermediate_result_name": "hint",
